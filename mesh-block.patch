+def _step_params(default_elset="EALL"):
+    """Pull the STEP source + mesh params from either a multipart upload or JSON."""
+    uploaded = request.files.get("step_file")
+    if uploaded is not None:
+        os.makedirs(STEP_UPLOAD_DIR, exist_ok=True)
+        path = os.path.join(STEP_UPLOAD_DIR, os.path.basename(uploaded.filename or "upload.step"))
+        uploaded.save(path)
+        f = request.form
+        return path, f.get("element_type", "S6"), f.get("target_size", ""), f.get("elset", default_elset)
+    d = request.get_json(silent=True) or {}
+    return (
+        (d.get("path") or "").strip().strip('"'),
+        d.get("element_type", "S6"),
+        d.get("target_size", ""),
+        d.get("elset", default_elset),
+    )
+
+
+@app.route("/mesh_block", methods=["POST"])
+def mesh_block_route():
+    """Mesh the STEP and return the *Node + *Element text (all elements in one set)."""
+    step_path, element_type, target_size, elset_name = _step_params()
+    if not step_path:
+        return jsonify({"ok": False, "error": "Provide a STEP file path (or drop/choose a file)."})
+    try:
+        with GMSH_LOCK:
+            m = mesh_step(step_path, element_type=element_type, target_size=target_size)
+        block = mesh_block(m["nodes"], m["elements"], m["element_type"], elset_name)
+    except (StepMeshError, InpWriteError) as e:
+        return jsonify({"ok": False, "error": str(e)})
+    except Exception as e:
+        return jsonify({"ok": False, "error": "Meshing failed: " + str(e)})
+    return jsonify({
+        "ok": True, "block": block, "elset": elset_name,
+        "num_nodes": m["num_nodes"], "num_elements": m["num_elements"],
+    })
+
