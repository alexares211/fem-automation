+<!-- ===== .inp mesh block (*Node + *Element) preview ===== -->
+<script>
+(function () {
+  const btn = document.getElementById("meshBlockBtn");
+  if (!btn) return;
+  const msg = document.getElementById("meshBlockMsg");
+  const out = document.getElementById("meshBlockOut");
+  const fileInput = document.getElementById("stepFile");
+  const pathInput = document.getElementById("stepPath");
+  const elemSel = document.getElementById("stepElemType");
+  const sizeInput = document.getElementById("stepSize");
+  const elsetInput = document.getElementById("stepElset");
+
+  btn.addEventListener("click", async () => {
+    const picked = fileInput && fileInput.files && fileInput.files[0];
+    const path = pathInput.value.trim();
+    if (!picked && !path) { msg.textContent = "Pick a STEP file or paste a path first."; return; }
+    btn.disabled = true;
+    msg.textContent = "Meshing…";
+    try {
+      let res;
+      if (picked) {
+        const fd = new FormData();
+        fd.append("step_file", picked);
+        fd.append("element_type", elemSel.value);
+        fd.append("target_size", sizeInput.value);
+        fd.append("elset", elsetInput.value);
+        res = await fetch("/mesh_block", { method: "POST", body: fd });
+      } else {
+        res = await fetch("/mesh_block", {
+          method: "POST",
+          headers: { "Content-Type": "application/json" },
+          body: JSON.stringify({
+            path, element_type: elemSel.value,
+            target_size: sizeInput.value, elset: elsetInput.value,
+          }),
+        });
+      }
+      const data = await res.json();
+      if (!data.ok) { msg.innerHTML = `<span class="row-error">${data.error}</span>`; out.style.display = "none"; return; }
+      msg.textContent = `${data.num_nodes} nodes, ${data.num_elements} elements in set "${data.elset}"`;
+      out.textContent = data.block;
+      out.style.display = "block";
+    } catch (err) {
+      msg.innerHTML = `<span class="row-error">${String(err)}</span>`;
+    } finally {
+      btn.disabled = false;
+    }
+  });
+})();
+</script>
 </body>
