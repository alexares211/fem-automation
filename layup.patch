+<!-- ===== Layup keyword-block preview ===== -->
+<script>
+(function () {
+  const btn = document.getElementById("layupPreviewBtn");
+  if (!btn) return;
+  const msg = document.getElementById("layupMsg");
+  const out = document.getElementById("layupBlock");
+  const matName = document.getElementById("matName");
+  const layupMat = document.getElementById("layupMat");
+  if (matName && layupMat) layupMat.value = matName.value;
+
+  btn.addEventListener("click", async () => {
+    msg.textContent = "";
+    try {
+      const res = await fetch("/section_block", {
+        method: "POST",
+        headers: { "Content-Type": "application/json" },
+        body: JSON.stringify({
+          layup: document.getElementById("layupAngles").value,
+          symmetric: document.getElementById("layupSym").checked,
+          thickness: document.getElementById("layupThk").value,
+          material: layupMat.value,
+          elset: document.getElementById("layupElset").value,
+        }),
+      });
+      const data = await res.json();
+      if (!data.ok) {
+        msg.innerHTML = `<span class="row-error">${data.error}</span>`;
+        out.style.display = "none";
+        return;
+      }
+      msg.textContent = `${data.num_plies} plies`;
+      out.textContent = data.block;
+      out.style.display = "block";
+    } catch (err) {
+      msg.innerHTML = `<span class="row-error">${String(err)}</span>`;
+    }
+  });
+})();
+</script>
